<script src="https://cdn.jsdelivr.net/npm/reveal.js@5.1.0/dist/reveal.js"></script>
<script src="https://cdn.jsdelivr.net/npm/reveal.js@5.1.0/plugin/notes/notes.js"></script>
<script src="kit/workshop-kit.js"></script>
<script>

  // === 響應式：手機直式＝單欄頁內捲動；其餘＝1600×900 固定畫布 ===
  function deckSize(){
    const portrait = window.matchMedia('(orientation: portrait)').matches;
    const w = window.innerWidth, h = window.innerHeight;
    if (portrait && w < 760) return { width:640, height:Math.max(1000, Math.round(640*h/Math.max(1,w))), margin:0.01, mobile:true, center:false, touch:false };
    return { width:1600, height:900, margin:0.02, mobile:false, center:false, touch:true };
  }
  function applyResponsive(){
    const n = deckSize();
    document.body.classList.toggle('mobile', n.mobile);
    Reveal.configure({ width:n.width, height:n.height, margin:n.margin, center:n.center, touch:n.touch });
    Reveal.layout();
  }
  const ds = deckSize();
  document.body.classList.toggle('mobile', ds.mobile);
  Reveal.initialize({
    hash:true, transition: WK.shot ? 'none' : 'slide', backgroundTransition:'fade',
    fragments: !WK.shot, center:ds.center, touch:ds.touch, progress:true, controls:true, slideNumber:'c/t',
    width:ds.width, height:ds.height, margin:ds.margin, minScale:0.2, maxScale:2,
    view:null, scrollActivationWidth:null, plugins:[RevealNotes]
  });
  Reveal.on('ready', applyResponsive);
  window.addEventListener('load', applyResponsive);
  let _rz; window.addEventListener('resize', ()=>{ clearTimeout(_rz); _rz=setTimeout(applyResponsive,180); });
  window.addEventListener('orientationchange', ()=>setTimeout(applyResponsive,250));
  Reveal.on('slidechanged', e=>{ if(e.currentSlide) e.currentSlide.scrollTop=0; });
  WK.init({ total: 150 });
  document.querySelectorAll('[data-prevent-swipe]').forEach(el=>['touchstart','touchmove','touchend'].forEach(ev=>el.addEventListener(ev,e=>e.stopPropagation(),{passive:false})));

(function(){
const SEC={intro:'#1F3B2D',loc:'#2E7D9A',com:'#D9822B',sur:'#C0392B',act:'#1F3B2D'};
const SECNAME={intro:'引起動機',loc:'定位',com:'通報',sur:'自救',act:'喚起行動'};
const TOTAL=150;
const store={get(k){try{return localStorage.getItem(k)}catch(e){return null}},set(k,v){try{localStorage.setItem(k,v)}catch(e){}}};

/* ---------- agenda ---------- */
(function(){const A=[[0,11,'intro','開場','講師介紹、兩段山難影片'],[11,29,'intro','案例與三角形','南二段三天天氣、出發投票、三個誤解'],[29,40,'loc','衛星定位原理','GNSS、冷熱開機、誤差與高度、飛航模式'],[40,65,'loc','定位實作','實作①四種方法讀座標　實作②座標格式與精度'],[65,75,'','休息',''],[75,105,'com','通報實作','設備選擇、SOS 流程、實作③網頁定位、實作④即時分享'],[105,125,'sur','自救','333 原則、失溫判斷與分級'],[125,145,'act','綜合演練','實作⑤情境卡全流程'],[145,150,'act','總結','行前檢核、帶走一句話、Q&A']];
 const box=document.getElementById('agenda');
 A.forEach(a=>{const r=document.createElement('div');const c=a[2]?SEC[a[2]]:'#9AA59F';
  r.style.cssText='display:flex;align-items:center;gap:20px';
  r.innerHTML='<span style="font-family:ui-monospace,monospace;font-size:20px;width:110px;color:#5F6B64">'+a[0]+'–'+a[1]+'</span><div style="height:44px;border-radius:10px;background:'+c+';width:'+((a[1]-a[0])*9+40)+'px;flex:none"></div><span style="font-size:24px;font-weight:900">'+a[3]+'</span><span style="font-size:20px;color:#5F6B64">'+a[4]+'</span>';
  box.appendChild(r)})})();

/* ---------- triangle ---------- */
const TRI={loc:['定位','標定自己的所在地','#2E7D9A',['手機（定位功能／GPS）','衛星通訊裝置（例如 inReach）','個人定位信標（PLB）','紙本地圖','指北針']],
 com:['通報','把位置傳出去','#D9822B',['手機（通話、訊息）','無線電對講機','衛星電話','衛星通訊裝置（例如 inReach）','隊友協助']],
 sur:['自救','活下去，等待救援','#C0392B',['野外求生：備齊裝備、節省體力、保持冷靜','生火：保暖、烹煮食物、淨化水源','庇護所：避風避雨、保持體溫、安全隱蔽','觀察氣象：雲層、風向風速、氣溫變化','野外救護：處理傷口、固定外傷、評估狀況']]};
document.querySelectorAll('#tri .v').forEach(g=>g.addEventListener('click',()=>{
  document.querySelectorAll('#tri .v').forEach(x=>x.classList.remove('sel'));g.classList.add('sel');
  const d=TRI[g.dataset.k];const box=document.getElementById('triInfo');
  box.style.borderTop='8px solid '+d[2];
  box.innerHTML='<h3 style="color:'+d[2]+';font-size:40px">'+d[0]+'</h3><p style="margin:0 0 12px;font-weight:700">目的：'+d[1]+'</p><ul style="font-size:22px">'+d[3].map(x=>'<li>'+x+'</li>').join('')+'</ul><p style="margin-top:14px"><button class="btn" data-zoom="images/triangle_info.jpg">看原簡報三角形全圖</button></p>'}));

/* ---------- flip ---------- */
document.querySelectorAll('.flip').forEach(f=>f.addEventListener('click',()=>f.classList.toggle('on')));

/* ---------- quiz ---------- */
let qRight=0,qDone=0;
document.querySelectorAll('.q').forEach(q=>{const bs=[...q.querySelectorAll('.opts button')];let done=false;
  bs.forEach((b,i)=>b.onclick=()=>{if(done)return;done=true;qDone++;const a=+q.dataset.a;
   bs[a].classList.add('right');if(i!==a)b.classList.add('wrong');else qRight++;
   q.querySelector('.fb').innerHTML=(i===a?'<span class="ok">✔ 答對了！</span> ':'<span class="bad">✘ 再想想：</span> ')+q.dataset.fb;
   document.getElementById('quizScore').textContent='已作答 '+qDone+' / 4，答對 '+qRight+' 題'})});

/* ---------- coordinates ---------- */
function toDMS(v,pos,neg){const h=v<0?neg:pos;v=Math.abs(v);let d=Math.floor(v),mf=(v-d)*60,m=Math.floor(mf),s=+((mf-m)*60).toFixed(2);if(s>=60){s=0;m++}if(m>=60){m=0;d++}return h+d+'° '+m+'′ '+s.toFixed(2)+'″'}
function parseDD(t){const m=t.replace(/[NnEe°]/g,' ').match(/(-?\d+(?:\.\d+)?)\s*[,，\s]\s*(-?\d+(?:\.\d+)?)/);if(!m)return null;const a=+m[1],b=+m[2];if(Math.abs(a)>90||Math.abs(b)>180)return null;return [a,b]}
function parseOneDMS(t){const n=t.match(/\d+(?:\.\d+)?/g);if(!n||n.length<2)return null;return (+n[0])+(+n[1])/60+((+n[2])||0)/3600}
function parseDMS(t){const parts=t.split(/[,，]|(?=[EeＥ東])/).filter(x=>/\d/.test(x));if(parts.length<2)return null;const a=parseOneDMS(parts[0]),b=parseOneDMS(parts[1]);if(a==null||b==null)return null;return [a,b]}
const ddIn=document.getElementById('ddIn'),dmsIn=document.getElementById('dmsIn'),cMsg=document.getElementById('convMsg'),cMap=document.getElementById('convMap');
function fromDD(){const p=parseDD(ddIn.value);if(!p){cMsg.innerHTML='<span class="bad">請輸入「緯度, 經度」，例如 25.0288, 121.5882</span>';return}
  dmsIn.value=toDMS(p[0],'N','S')+', '+toDMS(p[1],'E','W');cMsg.innerHTML='<span class="ok">✔ 已換算</span>　口語：北緯 '+p[0]+'、東經 '+p[1];cMap.href='https://www.google.com/maps?q='+p[0]+','+p[1]}
function fromDMS(){const p=parseDMS(dmsIn.value);if(!p){cMsg.innerHTML='<span class="bad">格式例：N25° 1′ 43.69″, E121° 35′ 17.63″</span>';return}
  ddIn.value=p[0].toFixed(6)+', '+p[1].toFixed(6);cMsg.innerHTML='<span class="ok">✔ 已換算</span>';cMap.href='https://www.google.com/maps?q='+p[0].toFixed(6)+','+p[1].toFixed(6)}
ddIn.addEventListener('input',fromDD);dmsIn.addEventListener('input',fromDMS);fromDD();
const my=document.getElementById('myCoord'),myO=document.getElementById('myCoordOut');
my.addEventListener('input',()=>{let p=parseDD(my.value),f='十進位度（DD）';if(!p||/[°′'″"]/.test(my.value)){const q=parseDMS(my.value);if(q){p=q;f='度分秒（DMS）'}}
  if(!p){myO.innerHTML='<span class="muted">輸入「緯度, 經度」</span>';return}
  myO.innerHTML='<span class="ok">✔ 你寫的是'+f+'</span>　<a target="_blank" rel="noopener" href="https://www.google.com/maps?q='+p[0]+','+p[1]+'">在地圖開啟</a><br>DD：'+p[0].toFixed(6)+', '+p[1].toFixed(6)+'　DMS：'+toDMS(p[0],'N','S')+', '+toDMS(p[1],'E','W')});

/* ---------- YouTube 嵌入：點一下才載入，換頁自動停止 ---------- */
function ytReset(y){y.classList.remove('on');y.innerHTML='<span class="ytp"></span>'}
document.querySelectorAll('.yt').forEach(y=>{
  y.style.backgroundImage='url(https://i.ytimg.com/vi/'+y.dataset.id+'/hqdefault.jpg)';
  y.setAttribute('role','button');y.setAttribute('aria-label','播放影片：'+(y.dataset.title||''));ytReset(y);
  y.addEventListener('click',()=>{if(y.classList.contains('on'))return;
    document.querySelectorAll('.yt.on').forEach(ytReset);y.classList.add('on');
    y.innerHTML='<iframe src="https://www.youtube-nocookie.com/embed/'+y.dataset.id+'?autoplay=1&rel=0&playsinline=1" title="'+(y.dataset.title||'')+'" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>'})});
Reveal.on('slidechanged',e=>{if(e.previousSlide)e.previousSlide.querySelectorAll('.yt.on').forEach(ytReset)});

/* ---------- 南二段三天天氣圖 ---------- */
const WX={'22':['images/s2_0722.jpg','南二段 7 月 22 日行程與天氣狀況','<b>7/22</b>　拉庫音溪山屋 → 雲峰 → 轆轆谷山屋。上午 8:41 讀到颱風路徑圖；11:18 回報「登頂雲峰了」，現場天氣晴朗。'],
 '23':['images/s2_0723.jpg','南二段 7 月 23 日天氣狀況','<b>7/23</b>　轆轆谷山屋 → 塔芬山 → 塔芬谷山屋。測站資料：氣溫 6–16°C、平均風速 1–2 m/s、幾乎沒有降雨，氣壓緩緩下降。'],
 '24':['images/s2_0724.jpg','南二段 7 月 24 日天氣狀況','<b>7/24</b>　塔芬谷山屋 → 南大水窟山 → 大水窟山屋。玉山北峰測站：氣溫 7–11°C、最大瞬間風達 17 m/s，上午 10 時後每小時雨量 10–35 毫米。']};
function wxShow(k){const d=WX[k];const im=document.getElementById('wxBig');im.src=d[0];im.alt=d[1];document.getElementById('wxCap').innerHTML=d[2];
  document.querySelectorAll('#wxTabs button').forEach(b=>b.classList.toggle('on',b.dataset.k===k))}
document.querySelectorAll('#wxTabs button').forEach(b=>b.addEventListener('click',()=>wxShow(b.dataset.k)));wxShow('22');

/* ---------- 四種定位方法：卡片切換手機畫面 ---------- */
const SV='<svg viewBox="0 0 306 576" preserveAspectRatio="xMidYMid slice" style="width:100%;height:100%;display:block" font-family="Noto Sans TC,Microsoft JhengHei,sans-serif">';
const lab=(x,y,n,t)=>{const w=52+t.length*16;return '<rect x="'+x+'" y="'+(y-17)+'" width="'+w+'" height="34" rx="17" fill="#1E2A24" opacity=".92"/><circle cx="'+(x+17)+'" cy="'+y+'" r="13" fill="#D9822B"/><text x="'+(x+17)+'" y="'+(y+6)+'" text-anchor="middle" font-size="16" font-weight="900" fill="#fff">'+n+'</text><text x="'+(x+38)+'" y="'+(y+6)+'" font-size="16" font-weight="700" fill="#fff">'+t+'</text>'};
const mapBg='<rect width="306" height="576" fill="#E6ECDF"/><path d="M110 250q50-40 100 0q20 60-40 90q-70 10-60-90z" fill="#CFE3C4"/><path d="M-10 150L320 210M90-10L60 590M-10 420L320 380M230-10L250 590" stroke="#fff" stroke-width="14" fill="none"/>';
const pin=(x,y)=>'<path d="M'+x+' '+y+'c-22-30-24-58 0-62c24 4 22 32 0 62z" fill="#C0392B"/><circle cx="'+x+'" cy="'+(y-40)+'" r="8" fill="#fff"/>';
const locBtn=(x,y,hl)=>'<circle cx="'+x+'" cy="'+y+'" r="26" fill="#fff" stroke="'+(hl?'#D9822B':'#C9D1CC')+'" stroke-width="'+(hl?5:2)+'"/><circle cx="'+x+'" cy="'+y+'" r="9" fill="none" stroke="#2E7D9A" stroke-width="3"/><path d="M'+x+' '+(y-17)+'v6M'+x+' '+(y+11)+'v6M'+(x-17)+' '+y+'h6M'+(x+11)+' '+y+'h6" stroke="#2E7D9A" stroke-width="3"/>';
const METH={
 g:{t:'① Google 地圖',cap:'示意圖：長按藍點後，座標出現在搜尋列',
  scr:SV+mapBg+'<rect x="14" y="20" width="278" height="52" rx="26" fill="#fff" stroke="#D9822B" stroke-width="4"/><text x="153" y="53" text-anchor="middle" font-size="20" font-weight="700" fill="#1E2A24">25.028803, 121.588231</text>'
   +'<circle cx="153" cy="330" r="46" fill="#2E7D9A" opacity=".18"/><circle cx="153" cy="330" r="12" fill="#2E7D9A" stroke="#fff" stroke-width="4"/>'+pin(153,318)+locBtn(262,500,true)
   +lab(118,98,4,'座標出現在這裡')+lab(20,150,1,'地圖放到最大')+lab(70,396,3,'長按藍點 2 秒')+lab(100,500,2,'按定位鍵')+'</svg>',
  steps:['兩指把地圖<b>放到最大</b>','按右下角<b>定位鍵</b>，等藍點穩定','<b>長按藍點約 2 秒</b>，放下一根圖釘','讀出經緯度：Android 在上方搜尋列；iPhone 把下方資訊卡往上滑'],
  go:'打開 Google 地圖，讀出你現在的座標，寫在下面。'},
 c:{t:'② 座標 APP',cap:'示意圖：iPhone「指南針」下方顯示度分秒',
  scr:SV+'<rect width="306" height="576" fill="#111814"/><circle cx="153" cy="210" r="118" fill="none" stroke="#fff" stroke-width="2"/><circle cx="153" cy="210" r="104" fill="none" stroke="#8FA39A" stroke-width="14" stroke-dasharray="2 9.2"/><path d="M153 84l-10-20h20z" fill="#E53935"/>'
   +'<text x="153" y="140" text-anchor="middle" fill="#E53935" font-size="22" font-weight="900">N</text><text x="232" y="218" text-anchor="middle" fill="#fff" font-size="20" font-weight="700">E</text><text x="153" y="298" text-anchor="middle" fill="#fff" font-size="20" font-weight="700">S</text><text x="74" y="218" text-anchor="middle" fill="#fff" font-size="20" font-weight="700">W</text>'
   +'<text x="153" y="225" text-anchor="middle" fill="#fff" font-size="42" font-weight="700">45°</text>'
   +'<rect x="18" y="412" width="270" height="84" rx="14" fill="none" stroke="#D9822B" stroke-width="4"/><text x="153" y="446" text-anchor="middle" fill="#fff" font-size="21" font-weight="700">25°01′44″ 北</text><text x="153" y="480" text-anchor="middle" fill="#fff" font-size="21" font-weight="700">121°35′18″ 東</text>'
   +'<text x="153" y="530" text-anchor="middle" fill="#9AA59F" font-size="16">海拔 120 公尺</text>'+lab(66,378,'★','讀這裡：度分秒')+'</svg>',
  steps:['Android：安裝並開啟「台灣大地羅盤」','iPhone：主畫面滑到最左頁，搜尋「指南針」','經緯度在畫面下方；iPhone 顯示的是<b>度分秒</b>','iPhone 沒有顯示座標：到「設定 → 定位服務 → 指南針」開啟「使用 App 期間」與「精確位置」'],
  go:'讀出座標，和方法①的數字比一比。'},
 l:{t:'③ LINE 位置分享',cap:'示意圖：送出前先按右上角定位鍵',
  scr:SV+mapBg+'<rect width="306" height="60" fill="#22382C"/><text x="153" y="39" text-anchor="middle" fill="#fff" font-size="20" font-weight="700">位置資訊</text><text x="20" y="40" fill="#fff" font-size="22">✕</text>'
   +pin(153,262)+locBtn(262,104,true)+lab(62,156,1,'多按幾次定位鍵')
   +'<rect x="0" y="410" width="306" height="166" fill="#fff"/><text x="20" y="446" font-size="19" font-weight="700" fill="#1E2A24">目前位置</text><text x="20" y="474" font-size="16" fill="#5F6B64">25.0288, 121.5882</text>'
   +'<rect x="20" y="496" width="266" height="52" rx="12" fill="#2F8F5B"/><text x="153" y="529" text-anchor="middle" fill="#fff" font-size="20" font-weight="700">分享</text>'+lab(150,446,2,'確認後分享')+'</svg>',
  steps:['聊天室左下角「＋」→「位置資訊」','送出前<b>多按幾次右上角定位鍵</b>，讓圖釘更新到現在的位置','確認圖釘位置正確，再按「分享」','收到的人點開訊息，就能在地圖上看到位置'],
  go:'把位置傳給隔壁同學，請對方點開確認位置對不對。'},
 s:{t:'④ 119 簡訊定位',cap:'實際畫面：新北市消防局 GPS 定位輔助系統（點圖放大）',
  scr:'<img class="wk-zoom" src="images/ntpc_sms_locate.jpg" alt="新北市消防局 GPS 定位輔助系統的手機畫面" style="width:100%;height:auto;display:block;cursor:zoom-in">',
  steps:['報案後，119 會傳一則<b>定位簡訊</b>到你的手機','點簡訊裡的連結，按「允許」讓瀏覽器取得位置','等經緯度出現；<b>定位需要時間累積精度</b>，不要急著關掉','按「傳送定位」，位置經網路回傳給 119'],
  go:'這個方法要 119 發簡訊才能操作。現在先確認手機瀏覽器已允許取得位置；完整練習在實作③網頁定位。'}};
function mShow(k){const d=METH[k];document.getElementById('mScr').innerHTML=d.scr;document.getElementById('mCap').textContent=d.cap;
  document.getElementById('mInfo').innerHTML='<h3 style="font-size:28px;margin-bottom:8px">'+d.t+'</h3><ol>'+d.steps.map(x=>'<li>'+x+'</li>').join('')+'</ol><div class="mdo">✋ <b>現在動手做：</b>'+d.go+'</div>';
  document.querySelectorAll('#mCards .mcard').forEach(b=>b.classList.toggle('on',b.dataset.k===k))}
document.querySelectorAll('#mCards .mcard').forEach(b=>b.addEventListener('click',()=>mShow(b.dataset.k)));mShow('g');

/* ---------- equipment ---------- */
const EQ={a:['郊山一日、有收訊',['📱 手機＋行動電源（主要）','📍 Google 地圖即時位置分享給留守人','🗺️ 離線地圖、紙圖與指北針（備援）','👤 出發前告知留守人行程']],
 b:['隊伍拉長、隊員間要聯絡',['📱 每人手機都是一層保險','📻 無線電對講機：購置成本低、無後續費用','🔊 VHF 戶外距離較遠；UHF 穿透性較強','🗣️ 事先約定頻道與通聯時間']],
 c:['多日縱走、大段無收訊（例：南二段）',['🛰️ 衛星通訊器（inReach）：SOS＋雙向訊息＋軌跡分享','📱 手機只當零星收訊時的備援','📶 稜線、開闊處短暫關飛航模式留下通聯紀錄','👤 與留守人約定回報時間與停損點']],
 d:['需要與外界語音詳談',['☎️ 衛星電話：可直接通話','💰 購置成本高，後續有月租或儲值費用','🛰️ 可搭配 inReach 做軌跡與 SOS','📱 手機仍是第一線工具']]};
document.querySelectorAll('#eqBtns button').forEach(b=>b.onclick=()=>{document.querySelectorAll('#eqBtns button').forEach(x=>x.classList.remove('fill'));b.classList.add('fill');
  const d=EQ[b.dataset.k];document.getElementById('eqOut').innerHTML='<h3>'+d[0]+'</h3><ul style="font-size:22px">'+d[1].map(x=>'<li style="list-style:none;margin-left:-1.2em">'+x+'</li>').join('')+'</ul><p class="muted" style="margin:10px 0 0;font-size:18px">原則：最可靠的一種當主要，其他當備援</p>'});

/* ---------- SOS order game ---------- */
const SOS=['危難者按下 inReach 的 SOS','經衛星網路傳送 SOS 訊息','Garmin 國際緊急回應中心（IERCC）接收','IERCC 電話聯絡國內權責單位：消防署（陸地）／海巡署（海域）','同時通知緊急聯絡人，並持續與求救者訊息同步','搜救出動'];
let sosStep=0;
function sosInit(){sosStep=0;const pool=document.getElementById('sosPool'),ch=document.getElementById('sosChain');pool.innerHTML='';ch.innerHTML='';
  SOS.forEach((t,i)=>{const c=document.createElement('div');c.className='c';c.innerHTML='<span class="num">'+(i+1)+'</span><span class="muted">？</span>';ch.appendChild(c)});
  SOS.map((t,i)=>[t,i]).sort(()=>Math.random()-.5).forEach(([t,i])=>{const b=document.createElement('button');b.textContent=t;b.onclick=()=>{
    const slot=ch.children[sosStep];
    if(i===sosStep){b.classList.add('used');slot.classList.add('good');slot.classList.remove('no');slot.innerHTML='<span class="num" style="background:var(--ok)">'+(i+1)+'</span>'+t;sosStep++;
      if(sosStep===SOS.length){const d=document.createElement('div');d.className='ok';d.style.fontSize='22px';d.textContent='🎉 完成！IERCC 24 小時全年無休專人應答。';ch.appendChild(d)}}
    else{slot.classList.add('no');setTimeout(()=>slot.classList.remove('no'),500)}};pool.appendChild(b)})}
document.getElementById('sosReset').onclick=sosInit;sosInit();

/* ---------- copy SMS ---------- */
document.getElementById('copySms').onclick=()=>{const t=document.getElementById('smsTpl').textContent,m=document.getElementById('copyMsg');
  (navigator.clipboard?navigator.clipboard.writeText(t):Promise.reject()).then(()=>m.textContent='✔ 已複製',()=>{const r=document.createRange();r.selectNodeContents(document.getElementById('smsTpl'));const s=getSelection();s.removeAllRanges();s.addRange(r);m.textContent='已選取，請按 Ctrl+C'})};

/* ---------- hypothermia slider ---------- */
const HY=[[35,99,'正常／未達失溫','#2F8F5B','中心溫度 35°C 以上。仍要注意保暖、補充熱量，預防進入失溫。'],
 [32,35,'一級失溫','#D9822B','意識清楚、顫抖、身體狀態 OK，還可以照顧自己。<br>→ 立刻換乾衣、熱水、阻絕熱交換。'],
 [28,32,'二級失溫 ☠','#C0392B','意識模糊、<b>停止顫抖</b>。進入第二級失溫，死亡率大幅提高！<br>→ 停止顫抖不是好轉，是惡化。'],
 [24,28,'三級失溫 ☠','#A02A1F','失去意識。'],
 [13.7,24,'四級失溫 ☠','#7A1F17','外觀已呈現死亡狀態。'],
 [0,13.7,'五級失溫 ☠','#4A1410','必定死亡（依原簡報分級）。']];
const hyR=document.getElementById('hyR');
function hy(){const v=+hyR.value;document.getElementById('hyT').textContent=v.toFixed(1);const l=HY.find(h=>v>=h[0]&&v<h[1])||HY[0];
  const b=document.getElementById('hyBox');b.style.borderTopColor=l[3];b.innerHTML='<h3 style="color:'+l[3]+';font-size:36px">'+l[2]+'</h3><p style="margin:0">'+l[4]+'</p>';document.getElementById('hyT').style.color=l[3]}
hyR.addEventListener('input',hy);hy();

/* ---------- scenarios ---------- */
const SCN=[['A · 起霧迷途','郊山傍晚突然起霧，你發現自己偏離軌跡約 60 公尺，手機電量 30%，只有一格訊號。'],
 ['B · 隊友扭傷','中級山第二天，隊友腳踝扭傷無法行走，現場沒有手機訊號，隊上有一台 inReach。'],
 ['C · 颱風逼近','多日縱走第 3 天，收到颱風消息後就失去訊號，留守人聯絡不上你們。'],
 ['D · 失溫徵兆','稜線上風雨交加，一位隊員開始劇烈顫抖、講話含糊，天快黑了。'],
 ['E · 手機摔壞','唯一裝了登山 APP 的手機摔壞，你有紙圖、指北針，隊友手機有電但沒訊號。'],
 ['F · 獨攀失聯','你一個人走郊山岔路迷途，手機剩 15%，家人只知道你「去爬山」。']];
let deck=[];
document.getElementById('scnDraw').onclick=()=>{if(!deck.length)deck=SCN.map((x,i)=>i).sort(()=>Math.random()-.5);const s=SCN[deck.pop()];
  document.getElementById('scnTag').textContent='情境 '+s[0]+'　（剩 '+deck.length+' 張）';document.getElementById('scnText').textContent=s[1]};

/* ---------- checklist ---------- */
const CK=['事先下載離線地圖','出發前把行程告知可靠的留守人','Google 地圖即時位置分享給留守人','開啟 Apple「尋找」／Google「尋找我的裝置」','安裝並註冊 119 報案 APP','裝好座標 APP，練習讀出經緯度','在登山口完成定位，再開飛航模式','行動電源與充電線','手機放透明防水袋','關閉省電模式、APP 定位權限設為「永遠」','清出手機儲存空間','紙本地圖＋指北針','保暖防寒衣物（失溫第一優先）','依行程風險評估 inReach／衛星電話／無線電','具備基本野外救護技能'];
const ckSaved=JSON.parse(store.get('soil_check')||'[]');const ckBox=document.getElementById('chk');
CK.forEach((t,i)=>{const l=document.createElement('label');const c=document.createElement('input');c.type='checkbox';c.checked=ckSaved.includes(i);l.classList.toggle('done',c.checked);
  l.appendChild(c);l.appendChild(document.createTextNode(t));c.onchange=()=>{l.classList.toggle('done',c.checked);saveCk()};ckBox.appendChild(l)});
function saveCk(){const v=[...ckBox.querySelectorAll('input')].map((c,i)=>c.checked?i:-1).filter(i=>i>=0);store.set('soil_check',JSON.stringify(v));
  document.getElementById('chkCount').textContent='已完成 '+v.length+' / '+CK.length+(v.length===CK.length?'　🎉 可以出發了！':'')}
saveCk();


/* ---------- 聽眾版（?clean）：展開答案 ---------- */
if(WK.clean){
  document.querySelectorAll('.flip').forEach(f=>f.classList.add('on'));
  document.querySelectorAll('.q').forEach(q=>{const b=q.querySelectorAll('.opts button')[+q.dataset.a];b&&b.click();});
  const ch=document.getElementById('sosChain'); if(ch) ch.innerHTML=SOS.map((t,i)=>'<div class="c good"><span class="num" style="background:var(--ok)">'+(i+1)+'</span>'+t+'</div>').join('');
  const pool=document.getElementById('sosPool'); if(pool) pool.innerHTML='';
  const st=document.getElementById('scnText'); if(st){ st.style.fontSize='21px'; st.innerHTML=SCN.map(s=>'<b>'+s[0]+'</b>　'+s[1]).join('<br>'); document.getElementById('scnTag').textContent='六張情境卡'; }
  const v=document.querySelector('#tri .v[data-k="loc"]'); v&&v.dispatchEvent(new Event('click'));
}
})();
</script>
<script type="module">
  import { initializeApp } from 'https://www.gstatic.com/firebasejs/11.0.2/firebase-app.js';
  import { getFirestore, collection, addDoc, onSnapshot, serverTimestamp, query, orderBy, doc, setDoc, updateDoc, getDocs, deleteDoc, increment } from 'https://www.gstatic.com/firebasejs/11.0.2/firebase-firestore.js';
  import { getAuth, signInAnonymously } from 'https://www.gstatic.com/firebasejs/11.0.2/firebase-auth.js';
  import { initializeAppCheck, ReCaptchaV3Provider } from 'https://www.gstatic.com/firebasejs/11.0.2/firebase-app-check.js';
  const firebaseConfig = {
    apiKey: "AIzaSyBPaIDGb3RaYhxYrXVE_6YndLUi2jLv1R4",
    authDomain: "html-slide-db.firebaseapp.com",
    projectId: "html-slide-db",
    storageBucket: "html-slide-db.firebasestorage.app",
    messagingSenderId: "1045858073731",
    appId: "1:1045858073731:web:8d70945fa081f49929afb6"
  };
  const app = initializeApp(firebaseConfig);
  // App Check 綁定 phu00572.github.io：本機開啟時互動資料無法讀寫（其餘頁面不受影響）
  try { initializeAppCheck(app, { provider: new ReCaptchaV3Provider('6LevoHstAAAAALRLwnA0DSLiXAK8wER_LEM-eP9b'), isTokenAutoRefreshEnabled: true }); } catch(e) { console.warn('App Check 未啟用', e); }
  const fdb = getFirestore(app);
  const auth = getAuth(app);
  // 不用 top-level await：介面先畫好，登入完成後才讀寫資料（本機／離線時版面照樣完整）
  const ready = signInAnonymously(auth).catch(e => console.error('匿名登入失敗', e));
  const SLUG = 'ost2026';
  function loadStore(k){ try { return localStorage.getItem(k); } catch(e){ return null; } }
  function saveStore(k,v){ try { localStorage.setItem(k,v); } catch(e){} }
  const COLORS = ['#2E7D9A','#D9822B','#C0392B','#1F3B2D','#2F8F5B','#7A5C99'];
  function escapeHtml(s){ return String(s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

  /* ---------- 文字雲 ---------- */
  const wordsRef = collection(fdb, SLUG + '_wordcloud');
  let wcData = [];
  async function wcSubmit(){
    const input = document.getElementById('wc-input'); const word = input.value.trim(); if(!word) return;
    const btn = document.getElementById('wc-btn'); btn.disabled = true;
    try { await ready; await addDoc(wordsRef, { word, created_at: serverTimestamp() }); input.value=''; } catch(e){ console.error(e); } finally { btn.disabled = false; }
  }
  document.getElementById('wc-input').addEventListener('keypress', e => { if(e.key==='Enter') wcSubmit(); });
  document.getElementById('wc-btn').addEventListener('click', wcSubmit);
  ready.then(() => onSnapshot(query(wordsRef, orderBy('created_at','asc')), snap => {
    const words = []; snap.forEach(d => words.push(d.data().word));
    const counts = {}; words.forEach(w => counts[w]=(counts[w]||0)+1);
    wcData = Object.entries(counts).sort((a,b)=>b[1]-a[1]);
    document.getElementById('wc-total').textContent = words.length;
    document.getElementById('wc-unique').textContent = wcData.length;
    document.getElementById('wc-list').innerHTML = wcData.slice(0,10).map(([w,c])=>
      `<div style="display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid var(--line)"><span>${escapeHtml(w)}</span><b style="color:var(--sec)">${c}</b></div>`).join('') || '<div class="muted">尚無資料</div>';
    document.getElementById('wc-empty').style.display = wcData.length ? 'none' : '';
    drawWordCloud();
  }, err => console.warn('文字雲讀取失敗（本機或網路）', err)));
  function drawWordCloud(){
    const canvas = document.getElementById('wc-canvas');
    if(!canvas || typeof WordCloud==='undefined') return;
    const r = canvas.getBoundingClientRect(); if(r.width<10||r.height<10) return;
    const sc = Reveal.getScale ? Reveal.getScale() : 1;
    canvas.width = r.width/sc; canvas.height = r.height/sc;
    if(!wcData.length) return;
    const max = wcData[0][1];
    WordCloud(canvas, { list: wcData.map(([w,c])=>[w, Math.max(26, Math.round(c/max*110))]), gridSize:8, weightFactor:1,
      fontFamily:'"Noto Sans TC","Microsoft JhengHei",sans-serif', fontWeight:900,
      color:()=>COLORS[Math.floor(Math.random()*COLORS.length)], backgroundColor:'transparent', rotateRatio:0.2, shuffle:true });
  }

  /* ---------- 投票（共用）：每個投票一份文件，放在 <slug>_poll ---------- */
  const uidOf = () => (auth.currentUser && auth.currentUser.uid) || (()=>{ const k=SLUG+'_uid'; let id=loadStore(k); if(!id){ id='u_'+Math.random().toString(36).slice(2,9); saveStore(k,id); } return id; })();
  function setupPoll(cfg){
    const p = cfg.prefix || '', ref = doc(fdb, SLUG + '_poll', cfg.doc);
    const box = document.getElementById(cfg.box);
    if(!box) return { reveal(){} };
    cfg.options.forEach(o => {
      const b = document.createElement('button'); b.className='poll-opt'; b.id=p+'po-'+o.id;
      b.innerHTML = `<span class="pk" id="${p}pk-${o.id}"></span><span style="flex:1">${o.label}</span><span class="pb"><span id="${p}pb-${o.id}"></span></span><span class="pp" id="${p}pp-${o.id}">${cfg.count ? '0 票' : '0%'}</span>`;
      b.onclick = async () => { try { await ready; await setDoc(ref, { updated_at: serverTimestamp(), votes: { [uidOf()]: o.id } }, { merge:true }); } catch(e){ console.error(e); } };
      box.appendChild(b);
    });
    ready.then(() => onSnapshot(ref, snap => {
      const votes = (snap.data()||{}).votes || {};
      const mine = votes[uidOf()] || null;
      const counts = {}; cfg.options.forEach(o=>counts[o.id]=0);
      Object.values(votes).forEach(v=>{ if(counts[v]!==undefined) counts[v]++; });
      const total = Object.values(counts).reduce((a,b)=>a+b,0);
      document.getElementById(cfg.total).textContent = total;
      cfg.options.forEach(o => {
        const pct = total ? Math.round(counts[o.id]/total*100) : 0;
        document.getElementById(p+'pb-'+o.id).style.width = pct+'%';
        document.getElementById(p+'pp-'+o.id).textContent = cfg.count ? counts[o.id]+' 票・'+pct+'%' : pct+'%';
        const k = document.getElementById(p+'pk-'+o.id);
        k.textContent = mine===o.id ? '✓' : ''; k.style.background = mine===o.id ? 'var(--sec)' : 'transparent';
      });
    }, err => console.warn('投票讀取失敗（本機或網路）', err)));
    return { reveal(){ if(cfg.answer) document.getElementById(p+'po-'+cfg.answer).classList.add('answer'); } };
  }
  /* 333 原則 */
  const poll333 = setupPoll({ doc:'results', box:'poll-options', total:'poll-total', answer:'c',
    options:[{id:'a',label:'🍙 3 週未進食'},{id:'b',label:'💧 3 天沒喝水'},{id:'c',label:'🥶 3 小時失溫'}] });
  document.getElementById('poll-reveal').onclick = poll333.reveal;
  if (WK.clean) poll333.reveal();
  /* 這樣的風雨，要不要從山屋出發 */
  setupPoll({ doc:'depart', prefix:'d-', box:'depart-options', total:'depart-total', count:true,
    options:[{id:'go',label:'🚶 出發'},{id:'stay',label:'🏠 不出發'}] });

  /* ---------- 全域提問牆 ---------- */
  const qaRef = collection(fdb, SLUG + '_qa');
  async function qaSubmit(){
    const input = document.getElementById('qa-input'); const text = input.value.trim(); if(!text) return;
    const btn = document.getElementById('qa-btn'); btn.disabled = true;
    try { await ready; await addDoc(qaRef, { text, likes:0, created_at: serverTimestamp() }); input.value=''; } catch(e){ console.error(e); } finally { btn.disabled = false; }
  }
  document.getElementById('qa-input').addEventListener('keypress', e => { if(e.key==='Enter') qaSubmit(); });
  document.getElementById('qa-btn').addEventListener('click', qaSubmit);
  const likedKey = SLUG + '_liked'; const liked = new Set(JSON.parse(loadStore(likedKey) || '[]'));
  window.qaLike = async function(id){
    if(liked.has(id)) return; liked.add(id); saveStore(likedKey, JSON.stringify([...liked]));
    try { await updateDoc(doc(fdb, SLUG+'_qa', id), { likes: increment(1) }); } catch(e){ console.error(e); liked.delete(id); saveStore(likedKey, JSON.stringify([...liked])); }
  };
  ready.then(() => onSnapshot(query(qaRef, orderBy('created_at','desc')), snap => {
    const items = []; snap.forEach(d => items.push({ id:d.id, ...d.data() }));
    items.sort((a,b)=>(b.likes||0)-(a.likes||0));
    document.getElementById('qa-list').innerHTML = items.length ? items.map(q =>
      `<div class="qa-item"><span class="qa-text">${escapeHtml(q.text)}</span><button class="qa-like" ${liked.has(q.id)?'disabled style="opacity:.55"':''} onclick="qaLike('${q.id}')">👍 ${q.likes||0}</button></div>`).join('')
      : '<div style="opacity:.6;text-align:center;padding:20px">還沒有問題，當第一個發問的人 🙋</div>';
  }, err => console.warn('提問牆讀取失敗（本機或網路）', err)));
  const qaSidebar = document.getElementById('qa-sidebar'), qaOverlay = document.getElementById('qa-overlay');
  window.toggleQA = function(force){
    const open = force!==undefined ? force : !qaSidebar.classList.contains('open');
    qaSidebar.classList.toggle('open', open); qaOverlay.classList.toggle('show', open);
    if(open) setTimeout(()=>document.getElementById('qa-input').focus(), 300);
  };
  document.getElementById('qa-handle').addEventListener('click', ()=>window.toggleQA());
  qaOverlay.addEventListener('click', ()=>window.toggleQA(false));

  /* ---------- 課後清除（?reset=1 講師按鈕） ---------- */
  window.clearInteractions = async function(silent){
    await ready;
    let total = 0;
    for (const c of [SLUG+'_wordcloud', SLUG+'_qa']) {
      const snap = await getDocs(collection(fdb, c));
      for (const d of snap.docs) { await deleteDoc(d.ref); total++; }
    }
    for (const d of ['results','depart']) { try { await deleteDoc(doc(fdb, SLUG+'_poll', d)); } catch(e){} }
    if(!silent) alert('已清空互動資料，共 ' + total + ' 筆。');
    return total;
  };
  if (new URLSearchParams(location.search).has('reset')) {
    const b = document.createElement('button');
    b.id = 'reset-btn'; b.textContent = '🗑 重置本場資料';
    b.style.cssText = 'position:fixed;right:16px;bottom:60px;z-index:1200;padding:11px 16px;background:rgba(192,57,43,.95);color:#fff;border:none;border-radius:24px;font-weight:900;font-size:15px;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.4)';
    b.onclick = async () => {
      if(!confirm('確定清空本場所有互動資料？（文字雲、投票、提問牆）此動作無法復原。')) return;
      b.disabled = true; b.textContent = '清除中…';
      try { const n = await window.clearInteractions(true); b.textContent = '✅ 已清空 ' + n + ' 筆'; }
      catch(e) { console.error(e); b.textContent = '❌ 失敗，見 console'; }
      setTimeout(()=>{ b.disabled=false; b.textContent='🗑 重置本場資料'; }, 2600);
    };
    document.body.appendChild(b);
  }

  /* ---------- QR code 與切頁重繪 ---------- */
  const BASE = 'https://phu00572.github.io/outdoor-survival-triangle/';
  function makeQR(id, hash){ const el=document.getElementById(id); if(!el || typeof QRCode==='undefined') return; el.innerHTML=''; new QRCode(el, { text: BASE + hash, width: 150, height: 150, correctLevel: QRCode.CorrectLevel.M }); }
  makeQR('qr-wc', '#/wordcloud'); makeQR('qr-poll', '#/poll'); makeQR('qr-depart', '#/depart');
  Reveal.on('slidechanged', e => { if(e.currentSlide && e.currentSlide.id==='wordcloud') setTimeout(drawWordCloud, 200); });
  if (Reveal.getCurrentSlide && Reveal.getCurrentSlide()?.id==='wordcloud') setTimeout(drawWordCloud, 400);
</script>
</body>
</html>
