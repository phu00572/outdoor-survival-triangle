<section data-section="喚起行動" data-at="147" data-title="帶走一句話">
<div class="pg dark" data-part="act">
  <div style="margin:auto 0;max-width:1300px">
    <div style="display:flex;gap:16px;margin-bottom:40px">
      <span class="badge" style="background:var(--loc)">定位</span><span class="badge" style="background:var(--com)">通報</span><span class="badge" style="background:var(--sur)">自救</span>
    </div>
